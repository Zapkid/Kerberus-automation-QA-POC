{
  "name": "kerberus-automation-qa-poc",
  "version": "1.0.0",
  "description": "QA automation infrastructure for web3/crypto dApp testing with MetaMask + Pocket Universe extension injection, Playwright, Page Object Model, and Allure reporting.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "prepare:extensions": "ts-node scripts/download-extensions.ts",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:polymarket": "playwright test --grep @polymarket",
    "test:security": "playwright test --grep @security",
    "test:ui": "playwright test --ui",
    "report:generate": "allure generate ./allure-results --output ./allure-report",
    "report:open": "allure open ./allure-report",
    "report:serve": "allure open ./allure-results",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "adm-zip": "^0.5.16",
    "allure": "^3.18.0",
    "allure-playwright": "^3.0.7",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}

# Base URL of the dApp under test
BASE_URL=https://example-dapp.kerberus.com

# --- MetaMask wallet configuration ---
# Never commit a real seed phrase / private key. Use a dedicated, funds-free
# test wallet (e.g. from a local Hardhat/Anvil chain or a testnet faucet).
METAMASK_SEED_PHRASE="test test test test test test test test test test test junk"
METAMASK_PASSWORD="Password1234!"
METAMASK_NETWORK_NAME="Localhost 8545"
METAMASK_RPC_URL="http://127.0.0.1:8545"
METAMASK_CHAIN_ID="31337"
METAMASK_SYMBOL="ETH"

# Pinned extension versions used by scripts/download-extensions.ts
METAMASK_VERSION=11.16.14

# --- Pocket Universe extension ---
# Pocket Universe is not open-source and cannot be auto-downloaded. Install it
# from the Chrome Web Store in a normal Chrome profile, then point this at the
# unpacked extension directory (chrome://extensions -> Developer mode ->
# locate the extension folder, or export it). See extensions/pocket-universe/README.md.
POCKET_UNIVERSE_PATH=./extensions/pocket-universe

# --- Polymarket (tests/polymarket/*.spec.ts) ---
POLYMARKET_URL=https://polymarket.com
# Polymarket trades real USDC on Polygon mainnet. Leave this false (default)
# so the Polymarket specs stop at the order review / wallet confirmation step
# and cancel instead of submitting a real transaction. Only your own funded
# wallet (real MATIC for gas + real USDC) can actually trade there - set this
# true deliberately, and only with a wallet you're okay spending from.
ALLOW_REAL_POLYMARKET_TRADE=false

# --- Security test target (tests/security/scam-dapp-warning.spec.ts) ---
# A dApp/site known to trigger Pocket Universe's malicious-transaction
# warning, used to verify that warning actually fires. Do NOT point this at
# a live, real-world scam site - use a controlled phishing-simulation
# harness instead (an internal red-team fixture, or a vendor's own test/demo
# malicious dApp if one is published). Leave blank to skip that spec.
SCAM_DAPP_URL=

# Misc
HEADLESS=false
SLOW_MO=0
